<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="8dp">

    <EditText
        android:id="@+id/edtInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_text"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:minHeight="60dp"
        android:textSize="18sp"
        android:textColor="?attr/colorOnSurface"
        style="@style/AppText.Medium"
        android:inputType="text|textCapSentences"
        android:maxLines="1"
        android:gravity="center_vertical"
        android:importantForAutofill="no"
        android:windowSoftInputMode="adjustPan" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/edtInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textColor="#F44336"
        android:textSize="12sp"
        android:visibility="gone"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/edtInput"
        app:layout_constraintBottom_toTopOf="@+id/edtInput"
        app:layout_constraintStart_toStartOf="@+id/edtInput"
        android:layout_marginStart="12dp"
        android:paddingHorizontal="4dp"
        android:background="?attr/colorSurface"
        android:text="Label"
        android:textSize="18sp"
        android:textColor="#757575"
        style="@style/AppText.Medium"
        android:elevation="2dp"
        android:labelFor="@+id/edtInput" />

</androidx.constraintlayout.widget.ConstraintLayout>